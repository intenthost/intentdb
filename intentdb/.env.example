# ─── IntentDB Gateway — Environment Configuration ─────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ──────────────────────────────────────────────
#  PostgreSQL Connection (cPanel local)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# Set DB_SSL=true only if your cPanel PostgreSQL requires SSL
DB_SSL=false

# ──────────────────────────────────────────────
#  Connection Pool
# ──────────────────────────────────────────────
# POOL_MIN: minimum warm connections (kept alive 24/7, no cold start)
# POOL_MAX: maximum concurrent connections
POOL_MIN=2
POOL_MAX=20

# Query timeouts in milliseconds (30s default)
STATEMENT_TIMEOUT=30000
QUERY_TIMEOUT=30000

# ──────────────────────────────────────────────
#  API Security
# ──────────────────────────────────────────────
# Generate a strong random key:  node scripts/generate-key.js
# This key is what your client apps use in DATABASE_URL
API_KEY=REPLACE_WITH_GENERATED_KEY

# ──────────────────────────────────────────────
#  Server
# ──────────────────────────────────────────────
# Port for the Node.js server (cPanel Node.js App uses its own port)
PORT=3000

# CORS: set to your domain(s) or * for open access
# Multiple domains: https://app1.com,https://app2.com
CORS_ORIGIN=*

# Request logging (true/false)
LOG_REQUESTS=true

# Single-page Interactive Documentation (/docs)
# Set to false to disable the /docs route completely (returns 404)
ENABLE_DOCS=true
